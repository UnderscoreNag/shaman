local function EnsureAssetDownloaded(filename, originalURL)
    local success, _ = pcall(readfile, filename)
    if success and _ ~= nil then return true end

    Notify("Downloading Asset", "Fetching " .. filename .. "...", 3)

    local finalURL = originalURL
    if FixCDN then
        local ok, fixed = pcall(FixCDN, originalURL)
        if ok and fixed then finalURL = fixed end
    end

    local ok, data = pcall(game:HttpGet, game, finalURL)
    if not ok or not data then
        Notify("Download Failed", "Could not fetch " .. filename, 3)
        return false
    end

    pcall(writefile, filename, data)
    Notify("Success", filename .. " saved.", 2)
    return true
end

